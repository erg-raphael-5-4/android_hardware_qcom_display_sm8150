// AUTO-DISABLED for raphael (sm8150 device using sm8350 display HAL).
// Module names in this file collide with hardware/qcom-caf/sm8350/display,
// which is the modern composer-service architecture the device wants
// (per PRODUCT_PACKAGES vendor.qti.hardware.display.composer-service in
// device/xiaomi/sm8150-common/msmnile.mk and the sm8350 color libs).
// sm8350 display HAL is on PRODUCT_SOONG_NAMESPACES; both versions visible
// to Make causes a duplicate-namespace error.
/*
cc_defaults {
    name: "display_defaults",
    cflags: [
        "-Wno-missing-field-initializers",
        "-Wconversion",
        "-Wall",
        "-Werror",
    ] + select(soong_config_variable("qtidisplay", "headless"), {
        "true": ["-DTARGET_HEADLESS"],
        default: [],
    }),
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
    ],
    header_libs: ["display_headers"],
}
*/

// Re-enabled under a unique name. hardware/qcom-caf/sm8150/media still needs
// these headers, and the sm8150 namespace does not import sm8350 where the
// other copy lives. The name must differ from sm8350's "display_headers":
// Soong namespaces isolate module names but Kati/Make does not, and a second
// MODULE.TARGET.HEADER_LIBRARIES.display_headers is a hard error in
// build/make/core/base_rules.mk regardless of whether anything is installed.
cc_library_headers {
    name: "display_headers_sm8150",
    vendor: true,
    export_include_dirs: [
        "include",
        "libcopybit",
        "libdrmutils",
        "libqdutils",
        "libqservice",
        "gpu_tonemapper",
        "sdm/include",
        "gralloc",
        "libdebug",
    ],
    header_libs: ["libhardware_headers", "display_intf_headers"],
    export_header_lib_headers: ["libhardware_headers", "display_intf_headers"],
}
